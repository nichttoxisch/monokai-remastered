{
  "name": "Monokai Remastered",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "colors": {
    "editor.foreground": "#B9B9B9",
    "editor.background": "#0C0C0C",
    "sideBar.background": "#0C0C0C",
    "editor.selectionBackground": "#2F2F2F",
    "titleBar.activeBackground": "#0C0C0C",
  },
  "tokenColors": [
    {
      "scope": [
        "variable.parameter.cpp",
        "variable.other.object",
      ],
      "settings": {
        "foreground": "#B9B9B9"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.type",
        "storage.modifier",
        "storage.type.struct",
        "storage.type.union",
        "entity.name.tag.html",
        "storage.type.class.cpp",
        "storage.type.modifier.access.control.public.cpp",
        "storage.type.modifier.access",
        "storage.type.enum.cpp",
        "storage.type.enum.enum-key.class.cpp",
        "meta.template.call.cpp",
      ],
      "settings": {
        "foreground": "#F4005F"
      }
    },
    {
      "scope": [
        "string",
      ],
      "settings": {
        "foreground": "#E0D561"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.function.preprocessor",
        "keyword.constant",
        "variable.other.enummember.cpp",
        "variable.other.unknown.endl.cpp",
      ],
      "settings": {
        "foreground": "#9d65ff"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.other.attribute-name.html",
        "meta.function-call.generic.python",
        "variable.other.unknown.cout.cpp",
        "variable.other.unknown.cerr.cpp",
      ],
      "settings": {
        "foreground": "#98E024"
      }
    },
    {
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type.alias",
        "meta.qualified_type",
        "entity.name.type.struct",
        "keyword.type",
        "entity.name.type.parameter.cpp",
        "entity.name.type.cpp",
        "entity.name.type.class.cpp",
      ],
      "settings": {
        "foreground": "#58D1EB",
      }
    },
    {
      "scope": [
        "comment",
      ],
      "settings": {
        "foreground": "#707070",
      }
    },
  ]
}